# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Docker Compose or local instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stackpulse?schema=public"

# Session Secret (random 32+ character string in production)
SESSION_SECRET="stackpulse-development-session-secret-key-32chars"

# GitHub Personal Access Token (optional, increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=""

# Client URL (for CORS and cookies)
CLIENT_URL="http://localhost:5173"
