# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Docker Compose or local instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stackpulse?schema=public"

# Session Secret (32+ character string used to sign session cookies)
SESSION_SECRET="change-this-to-a-secure-random-32-char-secret-in-production"

# GitHub Personal Access Token (Crucial for live demo: increases rate limit from 60 to 5,000 req/hr)
# Generate a free token at https://github.com/settings/tokens (no scopes required for public data)
GITHUB_TOKEN=""

# Client Web Application URL (used for CORS origin and cookie isolation)
CLIENT_URL="http://localhost:5173"
